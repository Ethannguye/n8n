# Demo: no accounts or API keys necessary.
RENDER_ENGINE=demo
SOCIAL_FACTORY_OUTPUT=./output
HOST=127.0.0.1
PORT=8765

# Optional OpenAI-compatible gateway (such as FreeLLMAPI).
# If blank, safe deterministic script templates are used.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional real rendering (requires MoneyPrinterTurbo installed and configured)
# RENDER_ENGINE=mpt
# MPT_HOME=

# Real publishing: deliberately disabled by default.
ENABLE_LIVE_PUBLISH=false
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
# Facebook Reels require a Page ID; Pinterest requires a board ID.
FACEBOOK_PAGE_ID=
PINTEREST_BOARD_ID=
